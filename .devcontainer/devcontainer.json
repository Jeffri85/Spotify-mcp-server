{
  "name": "Spotify MCP Server",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Gradio", "onAutoForward": "notify" }
  },
  "secrets": {
    "CLIENT_ID": { "description": "Spotify app client ID" },
    "CLIENT_SECRET": { "description": "Spotify app client secret" },
    "REDIRECT_URI": { "description": "Spotify redirect URI, e.g. http://127.0.0.1:7860/callback" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
